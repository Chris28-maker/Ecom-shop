{% comment %}
  Renders a standard dropdown style menu for the header.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    <li>
      <a href="{{ routes.all_products_collection_url }}" class="header__menu-item list-menu__item link link--text focus-inset" {% if request.page_type == 'collection' %}aria-current="page"{% endif %}>
        <span {% if request.page_type == 'collection' %}class="header__active-menu-item"{% endif %}>Shop</span>
        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret" viewBox="0 0 10 6" style="width: 10px; margin-left: 5px;">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
        </svg>
      </a>
    </li>
    <li>
      <a href="{{ routes.all_products_collection_url }}" class="header__menu-item list-menu__item link link--text focus-inset" {% if request.page_type == 'collection' %}aria-current="page"{% endif %}>
        <span {% if request.page_type == 'collection' %}class="header__active-menu-item"{% endif %}>On Sale</span>
      </a>
    </li>
    <li>
      <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending" class="header__menu-item list-menu__item link link--text focus-inset">
        <span>New Arrivals</span>
      </a>
    </li>
    <li>
      <a href="{{ routes.all_products_collection_url }}" class="header__menu-item list-menu__item link link--text focus-inset">
        <span>Brands</span>
      </a>
    </li>
  </ul>
</nav>
