          "default": "International Brands"
        },
        {
          "type": "text",
          "id": "stat_2_number",
          "label": "Stat 2 Number",
          "default": "2,000+"
        },
        {
          "type": "text",
          "id": "stat_2_label",
          "label": "Stat 2 Label",
          "default": "High-Quality Products"
        },
        {
          "type": "text",
          "id": "stat_3_number",
          "label": "Stat 3 Number",
          "default": "30,000+"
        },
        {
          "type": "text",
          "id": "stat_3_label",
          "label": "Stat 3 Label",
          "default": "Happy Customers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-with-text.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
