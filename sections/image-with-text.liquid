    {
      "type": "stats",
      "name": "Stats Row",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "stat_1_number",
          "label": "Stat 1 Number",
          "default": "200+"
        },
        {
          "type": "text",
          "id": "stat_1_label",
